<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-cyan-50/30 app-container">
  <%!-- Subtle animated background blobs --%>
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-200/20 to-cyan-200/20 rounded-full blur-3xl animate-blob"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-gradient-to-tr from-indigo-200/20 to-blue-200/20 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
    <div class="absolute top-1/2 left-1/2 w-72 h-72 bg-gradient-to-br from-cyan-200/20 to-teal-200/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="mb-8">
      <h1 class="text-5xl font-extrabold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-2">
        Settings
      </h1>
      <p class="text-gray-600">
        Manage your account preferences and settings
      </p>
    </div>

    <%!-- Settings Sections --%>
    <div class="space-y-6">
      <%!-- Account Information --%>
      <div class="relative bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-blue-50/50 to-cyan-50/50 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 flex items-center">
            <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Account Information
          </h2>
        </div>
        <div class="px-6 py-5">
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Email Address
              </label>
              <p class="text-gray-900 font-medium">{@user.email}</p>
              <p class="text-sm text-gray-500 mt-1">
                <%= if @user.confirmed_at do %>
                  <span class="inline-flex items-center text-green-600">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Verified
                  </span>
                <% else %>
                  <span class="inline-flex items-center text-yellow-600">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Not verified - check your email
                  </span>
                <% end %>
              </p>
            </div>
            <div>
              <.link
                href={~p"/users/settings"}
                class="inline-flex items-center px-5 py-2.5 border-2 border-blue-200 rounded-xl text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 transition-all shadow-sm hover:shadow-md"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Change Email or Password
              </.link>
            </div>
          </div>
        </div>
      </div>

      <%!-- Timezone Settings --%>
      <div class="relative bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-blue-50/50 to-cyan-50/50 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 flex items-center">
            <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Timezone
          </h2>
          <p class="text-sm text-gray-700 mt-2">
            Your timezone affects how dates are calculated for habit tracking and streaks
          </p>
        </div>
        <div class="px-6 py-5">
          <.form
            for={@timezone_form}
            id="timezone-form"
            phx-submit="update_timezone"
            class="space-y-4"
          >
            <div>
              <label for="timezone-select" class="block text-sm font-medium text-gray-700 mb-2">
                Select your timezone
              </label>
              <select
                id="timezone-select"
                name="user[timezone]"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors"
                style="font-size: 16px;"
              >
                <%= for tz <- @timezones do %>
                  <option value={tz} selected={tz == @user.timezone}>{tz}</option>
                <% end %>
              </select>
            </div>

            <div class="flex justify-end">
              <button
                type="submit"
                class="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-xl hover:opacity-90 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105"
              >
                Update Timezone
              </button>
            </div>
          </.form>
        </div>
      </div>

      <%!-- Email Reminder Settings --%>
      <div class="relative bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-blue-50/50 to-cyan-50/50 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-gray-900 flex items-center">
                <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                Email Reminders
              </h2>
              <p class="text-sm text-gray-700 mt-2">
                Get daily email reminders to help you stay on track
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                checked={@reminder_settings.enabled}
                phx-click="toggle_reminders"
                class="sr-only peer"
              />
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600">
              </div>
            </label>
          </div>
        </div>

        <%= if @reminder_settings.enabled do %>
          <div class="px-6 py-5">
            <.form
              for={@reminder_form}
              id="reminder-form"
              phx-submit="update_reminders"
              phx-change="validate_reminders"
              class="space-y-6"
            >
              <%!-- Time of Day --%>
              <div>
                <label for="reminder-time" class="block text-sm font-medium text-gray-700 mb-2">
                  Reminder Time
                </label>
                <input
                  type="time"
                  id="reminder-time"
                  name="reminder_settings[time_of_day]"
                  value={@reminder_settings.time_of_day}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors"
                  style="font-size: 16px;"
                />
                <p class="text-sm text-gray-500 mt-1">
                  Time in your local timezone
                </p>
              </div>

              <%!-- Habit Selection --%>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-3">
                  Which habits to remind
                </label>

                <div class="space-y-3">
                  <label class={[
                    "flex items-start p-4 border-2 rounded-lg cursor-pointer transition-all",
                    if(@reminder_settings.habit_selection == "all",
                      do: "border-blue-500 bg-blue-50",
                      else: "border-gray-200 hover:border-gray-300"
                    )
                  ]}>
                    <input
                      type="radio"
                      name="reminder_settings[habit_selection]"
                      value="all"
                      checked={@reminder_settings.habit_selection == "all"}
                      class="mt-1 mr-3"
                    />
                    <div class="flex-1">
                      <div class="font-medium text-gray-900">All Active Habits</div>
                      <div class="text-sm text-gray-600 mt-1">
                        Remind me about all my active habits
                      </div>
                    </div>
                  </label>

                  <label class={[
                    "flex items-start p-4 border-2 rounded-lg cursor-pointer transition-all",
                    if(@reminder_settings.habit_selection == "selected",
                      do: "border-blue-500 bg-blue-50",
                      else: "border-gray-200 hover:border-gray-300"
                    )
                  ]}>
                    <input
                      type="radio"
                      name="reminder_settings[habit_selection]"
                      value="selected"
                      checked={@reminder_settings.habit_selection == "selected"}
                      class="mt-1 mr-3"
                    />
                    <div class="flex-1">
                      <div class="font-medium text-gray-900">Specific Habits</div>
                      <div class="text-sm text-gray-600 mt-1">
                        Choose which habits to include
                      </div>
                    </div>
                  </label>
                </div>
              </div>

              <%!-- Habit Multi-Select --%>
              <%= if @reminder_settings.habit_selection == "selected" do %>
                <div class="pl-4 border-l-4 border-blue-200">
                  <label class="block text-sm font-medium text-gray-700 mb-3">
                    Select Habits
                  </label>
                  <%= if @habits == [] do %>
                    <p class="text-sm text-gray-500 italic py-4">
                      No active habits yet. Create some habits first!
                    </p>
                  <% else %>
                    <div class="space-y-2 max-h-60 overflow-y-auto">
                      <%= for habit <- @habits do %>
                        <label class="flex items-center p-3 hover:bg-gray-50 rounded-lg cursor-pointer transition-colors">
                          <input
                            type="checkbox"
                            name="reminder_settings[selected_habit_ids][]"
                            value={habit.id}
                            checked={habit.id in (@reminder_settings.selected_habit_ids || [])}
                            class="mr-3 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                          />
                          <span class="text-2xl mr-2">{habit.icon}</span>
                          <span class="text-gray-900">{habit.name}</span>
                        </label>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <div class="flex justify-end pt-4 border-t border-gray-200">
                <button
                  type="submit"
                  class="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-xl hover:opacity-90 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105"
                >
                  Save Reminder Settings
                </button>
              </div>
            </.form>
          </div>
        <% end %>
      </div>

      <%!-- Danger Zone --%>
      <div class="relative bg-white rounded-2xl shadow-sm border-2 border-red-200 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-red-50/50 to-orange-50/50 border-b border-red-200">
          <h2 class="text-xl font-bold text-red-700 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Danger Zone
          </h2>
        </div>
        <div class="px-6 py-5">
          <p class="text-gray-600 mb-4">
            Once you delete your account, there is no going back. All your habits and data will be permanently removed within 30 days.
          </p>

          <button
            type="button"
            phx-click="request_deletion"
            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
          >
            Delete Account
          </button>
        </div>
      </div>
    </div>

    <%!-- Deletion Confirmation Modal --%>
    <%= if assigns[:show_deletion_modal] do %>
      <div
        class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 px-4"
        phx-click="cancel_deletion"
      >
        <div
          class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl"
          phx-click={JS.stop_propagation()}
        >
          <div class="flex items-center mb-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900">
              Confirm Account Deletion
            </h3>
          </div>

          <p class="text-gray-700 mb-6">
            Are you absolutely sure you want to delete your account? This action cannot be undone.
            All your habits, logs, and data will be permanently deleted within 30 days.
          </p>

          <div class="flex gap-3 justify-end">
            <button
              type="button"
              phx-click="cancel_deletion"
              class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors font-medium"
            >
              Cancel
            </button>
            <button
              type="button"
              phx-click="confirm_deletion"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
            >
              Yes, Delete My Account
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
