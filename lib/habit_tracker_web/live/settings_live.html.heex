<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 dark:from-gray-900 dark:via-indigo-950 dark:to-purple-950 app-background" phx-hook="ThemeSync" id="settings-container">
  <div class="max-w-4xl mx-auto px-4 py-8 relative z-10">
    <%!-- Header --%>
    <div class="mb-8">
      <h1 class="text-4xl font-bold bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 dark:from-indigo-400 dark:via-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
        Settings
      </h1>
      <p class="mt-3 text-lg text-gray-700 dark:text-gray-300">
        Manage your account preferences and settings
      </p>
    </div>

    <%!-- Settings Sections --%>
    <div class="space-y-6">
      <%!-- Account Information --%>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border-b border-gray-200 dark:border-gray-700">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
            <.icon name="hero-user-circle" class="w-6 h-6 mr-2 text-indigo-600 dark:text-indigo-400" />
            Account Information
          </h2>
        </div>
        <div class="px-6 py-5">
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                Email Address
              </label>
              <p class="text-gray-900 dark:text-white font-medium">{@user.email}</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                <%= if @user.confirmed_at do %>
                  <span class="inline-flex items-center text-green-600 dark:text-green-400">
                    <.icon name="hero-check-circle" class="w-4 h-4 mr-1" />
                    Verified
                  </span>
                <% else %>
                  <span class="inline-flex items-center text-yellow-600 dark:text-yellow-400">
                    <.icon name="hero-exclamation-circle" class="w-4 h-4 mr-1" />
                    Not verified - check your email
                  </span>
                <% end %>
              </p>
            </div>
            <div>
              <.link
                href={~p"/users/settings"}
                class="inline-flex items-center px-5 py-2.5 border-2 border-indigo-200 dark:border-indigo-800 rounded-xl text-sm font-semibold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/20 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 transition-all shadow-sm hover:shadow-md"
              >
                <.icon name="hero-pencil" class="w-4 h-4 mr-2" />
                Change Email or Password
              </.link>
            </div>
          </div>
        </div>
      </div>

      <%!-- Timezone Settings --%>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border-b border-gray-200 dark:border-gray-700">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
            <.icon name="hero-globe-alt" class="w-6 h-6 mr-2 text-indigo-600 dark:text-indigo-400" />
            Timezone
          </h2>
          <p class="text-sm text-gray-700 dark:text-gray-300 mt-2">
            Your timezone affects how dates are calculated for habit tracking and streaks
          </p>
        </div>
        <div class="px-6 py-5">
          <.form
            for={@timezone_form}
            id="timezone-form"
            phx-submit="update_timezone"
            class="space-y-4"
          >
            <div>
              <label for="timezone-select" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Select your timezone
              </label>
              <select
                id="timezone-select"
                name="user[timezone]"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors"
                style="font-size: 16px;"
              >
                <%= for tz <- @timezones do %>
                  <option value={tz} selected={tz == @user.timezone}>{tz}</option>
                <% end %>
              </select>
            </div>

            <div class="flex justify-end">
              <button
                type="submit"
                class="px-6 py-3 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white rounded-xl hover:from-indigo-700 hover:via-purple-700 hover:to-pink-700 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105"
              >
                Update Timezone
              </button>
            </div>
          </.form>
        </div>
      </div>

      <%!-- Theme Settings --%>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border-b border-gray-200 dark:border-gray-700">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
            <.icon name="hero-swatch" class="w-6 h-6 mr-2 text-indigo-600 dark:text-indigo-400" />
            Appearance
          </h2>
          <p class="text-sm text-gray-700 dark:text-gray-300 mt-2">
            Choose your preferred color theme
          </p>
        </div>
        <div class="px-6 py-5">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <label class={[
              "relative flex flex-col items-center p-4 border-2 rounded-lg cursor-pointer transition-all",
              if(@theme == "light",
                do: "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20",
                else: "border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
              )
            ]}>
              <input
                type="radio"
                name="theme"
                value="light"
                checked={@theme == "light"}
                phx-click="update_theme"
                phx-value-theme="light"
                class="sr-only"
              />
              <.icon name="hero-sun" class="w-8 h-8 mb-2 text-yellow-500" />
              <div class="font-medium text-gray-900 dark:text-white">Light</div>
              <div class="text-sm text-gray-600 dark:text-gray-400 text-center mt-1">
                Always use light theme
              </div>
              <%= if @theme == "light" do %>
                <div class="absolute top-2 right-2">
                  <.icon name="hero-check-circle" class="w-5 h-5 text-indigo-600" />
                </div>
              <% end %>
            </label>

            <label class={[
              "relative flex flex-col items-center p-4 border-2 rounded-lg cursor-pointer transition-all",
              if(@theme == "dark",
                do: "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20",
                else: "border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
              )
            ]}>
              <input
                type="radio"
                name="theme"
                value="dark"
                checked={@theme == "dark"}
                phx-click="update_theme"
                phx-value-theme="dark"
                class="sr-only"
              />
              <.icon name="hero-moon" class="w-8 h-8 mb-2 text-indigo-500" />
              <div class="font-medium text-gray-900 dark:text-white">Dark</div>
              <div class="text-sm text-gray-600 dark:text-gray-400 text-center mt-1">
                Always use dark theme
              </div>
              <%= if @theme == "dark" do %>
                <div class="absolute top-2 right-2">
                  <.icon name="hero-check-circle" class="w-5 h-5 text-indigo-600" />
                </div>
              <% end %>
            </label>

            <label class={[
              "relative flex flex-col items-center p-4 border-2 rounded-lg cursor-pointer transition-all",
              if(@theme == "system",
                do: "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20",
                else: "border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
              )
            ]}>
              <input
                type="radio"
                name="theme"
                value="system"
                checked={@theme == "system"}
                phx-click="update_theme"
                phx-value-theme="system"
                class="sr-only"
              />
              <.icon name="hero-computer-desktop" class="w-8 h-8 mb-2 text-gray-500" />
              <div class="font-medium text-gray-900 dark:text-white">System</div>
              <div class="text-sm text-gray-600 dark:text-gray-400 text-center mt-1">
                Follow device preference
              </div>
              <%= if @theme == "system" do %>
                <div class="absolute top-2 right-2">
                  <.icon name="hero-check-circle" class="w-5 h-5 text-indigo-600" />
                </div>
              <% end %>
            </label>
          </div>
        </div>
      </div>

      <%!-- Email Reminder Settings --%>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
                <.icon name="hero-bell" class="w-6 h-6 mr-2 text-indigo-600 dark:text-indigo-400" />
                Email Reminders
              </h2>
              <p class="text-sm text-gray-700 dark:text-gray-300 mt-2">
                Get daily email reminders to help you stay on track
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                checked={@reminder_settings.enabled}
                phx-click="toggle_reminders"
                class="sr-only peer"
              />
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 dark:peer-focus:ring-indigo-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-indigo-600">
              </div>
            </label>
          </div>
        </div>

        <%= if @reminder_settings.enabled do %>
          <div class="px-6 py-5">
            <.form
              for={@reminder_form}
              id="reminder-form"
              phx-submit="update_reminders"
              phx-change="validate_reminders"
              class="space-y-6"
            >
              <%!-- Time of Day --%>
              <div>
                <label for="reminder-time" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Reminder Time
                </label>
                <input
                  type="time"
                  id="reminder-time"
                  name="reminder_settings[time_of_day]"
                  value={@reminder_settings.time_of_day}
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors"
                  style="font-size: 16px;"
                />
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                  Time in your local timezone
                </p>
              </div>

              <%!-- Habit Selection --%>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">
                  Which habits to remind
                </label>

                <div class="space-y-3">
                  <label class={[
                    "flex items-start p-4 border-2 rounded-lg cursor-pointer transition-all",
                    if(@reminder_settings.habit_selection == "all",
                      do: "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20",
                      else: "border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
                    )
                  ]}>
                    <input
                      type="radio"
                      name="reminder_settings[habit_selection]"
                      value="all"
                      checked={@reminder_settings.habit_selection == "all"}
                      class="mt-1 mr-3"
                    />
                    <div class="flex-1">
                      <div class="font-medium text-gray-900 dark:text-white">All Active Habits</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                        Remind me about all my active habits
                      </div>
                    </div>
                  </label>

                  <label class={[
                    "flex items-start p-4 border-2 rounded-lg cursor-pointer transition-all",
                    if(@reminder_settings.habit_selection == "selected",
                      do: "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/20",
                      else: "border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600"
                    )
                  ]}>
                    <input
                      type="radio"
                      name="reminder_settings[habit_selection]"
                      value="selected"
                      checked={@reminder_settings.habit_selection == "selected"}
                      class="mt-1 mr-3"
                    />
                    <div class="flex-1">
                      <div class="font-medium text-gray-900 dark:text-white">Specific Habits</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                        Choose which habits to include
                      </div>
                    </div>
                  </label>
                </div>
              </div>

              <%!-- Habit Multi-Select --%>
              <%= if @reminder_settings.habit_selection == "selected" do %>
                <div class="pl-4 border-l-4 border-indigo-200 dark:border-indigo-800">
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">
                    Select Habits
                  </label>
                  <%= if @habits == [] do %>
                    <p class="text-sm text-gray-500 dark:text-gray-400 italic py-4">
                      No active habits yet. Create some habits first!
                    </p>
                  <% else %>
                    <div class="space-y-2 max-h-60 overflow-y-auto">
                      <%= for habit <- @habits do %>
                        <label class="flex items-center p-3 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg cursor-pointer transition-colors">
                          <input
                            type="checkbox"
                            name="reminder_settings[selected_habit_ids][]"
                            value={habit.id}
                            checked={habit.id in (@reminder_settings.selected_habit_ids || [])}
                            class="mr-3 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                          />
                          <span class="text-2xl mr-2">{habit.icon}</span>
                          <span class="text-gray-900 dark:text-white">{habit.name}</span>
                        </label>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <div class="flex justify-end pt-4 border-t border-gray-200 dark:border-gray-700">
                <button
                  type="submit"
                  class="px-6 py-3 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white rounded-xl hover:from-indigo-700 hover:via-purple-700 hover:to-pink-700 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105"
                >
                  Save Reminder Settings
                </button>
              </div>
            </.form>
          </div>
        <% end %>
      </div>

      <%!-- Danger Zone --%>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border-2 border-red-300 dark:border-red-900 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 border-b border-red-200 dark:border-red-900">
          <h2 class="text-xl font-bold text-red-700 dark:text-red-400 flex items-center">
            <.icon name="hero-exclamation-triangle" class="w-6 h-6 mr-2" />
            Danger Zone
          </h2>
        </div>
        <div class="px-6 py-5">
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Once you delete your account, there is no going back. All your habits and data will be permanently removed within 30 days.
          </p>

          <button
            type="button"
            phx-click="request_deletion"
            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
          >
            Delete Account
          </button>
        </div>
      </div>
    </div>

    <%!-- Deletion Confirmation Modal --%>
    <%= if assigns[:show_deletion_modal] do %>
      <div
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 px-4"
        phx-click="cancel_deletion"
      >
        <div
          class="bg-white dark:bg-gray-800 rounded-xl p-6 max-w-md w-full shadow-2xl"
          phx-click={JS.stop_propagation()}
        >
          <div class="flex items-center mb-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/20 flex items-center justify-center mr-4">
              <.icon name="hero-exclamation-triangle" class="w-6 h-6 text-red-600 dark:text-red-400" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">
              Confirm Account Deletion
            </h3>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-6">
            Are you absolutely sure you want to delete your account? This action cannot be undone.
            All your habits, logs, and data will be permanently deleted within 30 days.
          </p>

          <div class="flex gap-3 justify-end">
            <button
              type="button"
              phx-click="cancel_deletion"
              class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors font-medium"
            >
              Cancel
            </button>
            <button
              type="button"
              phx-click="confirm_deletion"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium"
            >
              Yes, Delete My Account
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
