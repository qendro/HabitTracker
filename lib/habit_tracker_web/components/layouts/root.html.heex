<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#17675e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Health Journal" />
    <.live_title default="Health Journal">{assigns[:page_title]}</.live_title>
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <link rel="apple-touch-icon" href={~p"/images/icon-180.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body data-journal-user={if @current_scope, do: @current_scope.user.id, else: "guest"}>
    <header>
      <.link href={~p"/app/today"}>Health Journal</.link><span>Private observations</span>
    </header>
    <div id="connection-status" role="status" hidden>
      Disconnected. Not saved yet. Text drafts stay in this tab; reselect unfinished photos after reloading.
    </div>
    <main>{@inner_content}</main>
    <nav :if={@current_scope} aria-label="Main navigation">
      <.link navigate={~p"/app/today"}>Today</.link>
      <.link navigate={~p"/app/history"}>History</.link>
      <.link navigate={~p"/app/settings"}>Settings</.link>
    </nav>
  </body>
</html>
