<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content="Track your habits and build better routines with HabitTracker" />
    <.live_title default="HabitTracker" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-gradient-to-br from-blue-50 via-white to-cyan-50">
    <%!-- Mobile Header --%>
    <%= if @current_scope && !assigns[:hide_header] do %>
      <header 
        class="md:hidden fixed top-0 left-0 right-0 z-40 h-16 bg-white border-b border-gray-200 shadow-sm transition-transform duration-300"
        id="mobile-header"
        phx-hook="ScrollHeader"
        aria-label="Mobile header"
      >
        <div class="flex items-center justify-between px-4 h-16">
          <.link href={~p"/app/today"} class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-xl flex items-center justify-center shadow-md">
              <span class="text-white text-lg font-bold">H</span>
            </div>
            <span class="text-lg font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">
              Habit Tracker
            </span>
          </.link>
          <div class="relative" x-data="{ open: false }" @click.away="open = false">
            <button 
              @click="open = !open"
              class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-600 hover:opacity-90 text-white transition-all shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              aria-label="User menu"
              aria-expanded="false"
              x-bind:aria-expanded="open.toString()"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </button>
            <div 
              x-show="open"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="transform opacity-0 scale-95"
              x-transition:enter-end="transform opacity-100 scale-100"
              x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="transform opacity-100 scale-100"
              x-transition:leave-end="transform opacity-0 scale-95"
              class="absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-gray-200 py-2 z-50"
              style="display: none;"
            >
              <div class="px-4 py-3 border-b border-gray-200">
                <p class="text-xs text-gray-500 font-medium">Signed in as</p>
                <p class="text-sm font-semibold text-gray-900 truncate">{@current_scope.user.email}</p>
              </div>
              <.link 
                href={~p"/app/settings"} 
                class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 transition-colors"
              >
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="font-medium">Settings</span>
                </div>
              </.link>
              <.link 
                href={~p"/users/log-out"} 
                method="delete" 
                class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors"
              >
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span class="font-medium">Log out</span>
                </div>
              </.link>
            </div>
          </div>
        </div>
      </header>
    <% end %>

    <%!-- Desktop Navigation --%>
    <%= if !assigns[:hide_header] do %>
    <nav class="hidden md:block bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm" aria-label="Main navigation">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <%= if @current_scope do %>
            <div class="flex items-center space-x-8">
              <.link href={~p"/app/today"} class="flex items-center space-x-2">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-xl flex items-center justify-center shadow-md">
                  <span class="text-white text-xl font-bold">H</span>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">
                  Habit Tracker
                </span>
              </.link>
              <div class="flex space-x-2">
                <.link 
                  href={~p"/app/today"} 
                  class={"nav-link " <> if(@current_path == "/app/today" || String.starts_with?(@current_path || "", "/app/day/"), do: "nav-link-active", else: "")}
                  aria-label="Today's habits"
                  aria-current={if(@current_path == "/app/today" || String.starts_with?(@current_path || "", "/app/day/"), do: "page", else: false)}
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span>Today</span>
                </.link>
                <.link
                  href={~p"/app/journal"}
                  class={"nav-link " <> if(@current_path == "/app/journal" || String.starts_with?(@current_path || "", "/app/journal/"), do: "nav-link-active", else: "")}
                  aria-label="Journal"
                  aria-current={if(@current_path == "/app/journal" || String.starts_with?(@current_path || "", "/app/journal/"), do: "page", else: false)}
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 19 7.5 19S10.832 18.523 12 17.747m0-11.494C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13c-1.168-.776-2.754-1.253-4.5-1.253s-3.332.477-4.5 1.253" />
                  </svg>
                  <span>Journal</span>
                </.link>
                <.link 
                  href={~p"/app/habits"} 
                  class={"nav-link " <> if(@current_path == "/app/habits", do: "nav-link-active", else: "")}
                  aria-label="Manage habits"
                  aria-current={if(@current_path == "/app/habits", do: "page", else: false)}
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <span>Habits</span>
                </.link>
              </div>
            </div>
            <div class="relative" x-data="{ open: false }" @click.away="open = false">
              <button 
                @click="open = !open"
                class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-600 hover:opacity-90 text-white transition-all shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                aria-label="User menu"
                aria-expanded="false"
                x-bind:aria-expanded="open.toString()"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </button>
              <div 
                x-show="open"
                x-transition:enter="transition ease-out duration-100"
                x-transition:enter-start="transform opacity-0 scale-95"
                x-transition:enter-end="transform opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-75"
                x-transition:leave-start="transform opacity-100 scale-100"
                x-transition:leave-end="transform opacity-0 scale-95"
                class="absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-gray-200 py-2 z-50"
                style="display: none;"
              >
                <div class="px-4 py-3 border-b border-gray-200">
                  <p class="text-xs text-gray-500 font-medium">Signed in as</p>
                  <p class="text-sm font-semibold text-gray-900 truncate">{@current_scope.user.email}</p>
                </div>
                <.link 
                  href={~p"/app/settings"} 
                  class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="font-medium">Settings</span>
                  </div>
                </.link>
                <.link 
                  href={~p"/users/log-out"} 
                  method="delete" 
                  class="block px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="font-medium">Log out</span>
                  </div>
                </.link>
              </div>
            </div>
          <% else %>
            <div class="flex items-center justify-between w-full">
              <.link href={~p"/"} class="flex items-center space-x-2">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-xl flex items-center justify-center shadow-md">
                  <span class="text-white text-xl font-bold">H</span>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">
                  Habit Tracker
                </span>
              </.link>
              <div class="flex items-center space-x-4">
                <.link 
                  href={~p"/users/log-in"} 
                  class="px-6 py-2.5 bg-white text-gray-900 rounded-lg font-semibold border-2 border-gray-200 hover:border-blue-600 transition-all shadow-md hover:shadow-lg"
                  aria-label="Log in to your account"
                >
                  Log in
                </.link>
                <.link 
                  href={~p"/users/register"} 
                  class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-lg font-semibold hover:opacity-90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
                  aria-label="Register new account"
                >
                  Get Started
                </.link>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </nav>
    <% end %>

    <%!-- Mobile Bottom Navigation --%>
    <%= if @current_scope && !assigns[:hide_header] do %>
      <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-50 safe-area-bottom shadow-lg" aria-label="Mobile navigation">
        <div class="flex items-center justify-around h-16">
          <.link 
            href={~p"/app/today"} 
            class={"mobile-nav-link " <> if(@current_path == "/app/today" || String.starts_with?(@current_path || "", "/app/day/"), do: "mobile-nav-link-active", else: "")}
            aria-label="Today's habits"
            aria-current={if(@current_path == "/app/today" || String.starts_with?(@current_path || "", "/app/day/"), do: "page", else: false)}
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span class="text-xs mt-1 font-medium">Today</span>
          </.link>
          <.link
            href={~p"/app/journal"}
            class={"mobile-nav-link " <> if(@current_path == "/app/journal" || String.starts_with?(@current_path || "", "/app/journal/"), do: "mobile-nav-link-active", else: "")}
            aria-label="Journal"
            aria-current={if(@current_path == "/app/journal" || String.starts_with?(@current_path || "", "/app/journal/"), do: "page", else: false)}
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 19 7.5 19S10.832 18.523 12 17.747m0-11.494C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13c-1.168-.776-2.754-1.253-4.5-1.253s-3.332.477-4.5 1.253" />
            </svg>
            <span class="text-xs mt-1 font-medium">Journal</span>
          </.link>
          <.link 
            href={~p"/app/habits"} 
            class={"mobile-nav-link " <> if(@current_path == "/app/habits", do: "mobile-nav-link-active", else: "")}
            aria-label="Manage habits"
            aria-current={if(@current_path == "/app/habits", do: "page", else: false)}
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <span class="text-xs mt-1 font-medium">Habits</span>
          </.link>
          <.link 
            href={~p"/app/settings"} 
            class={"mobile-nav-link " <> if(@current_path == "/app/settings", do: "mobile-nav-link-active", else: "")}
            aria-label="Settings"
            aria-current={if(@current_path == "/app/settings", do: "page", else: false)}
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-xs mt-1 font-medium">Settings</span>
          </.link>
        </div>
      </nav>
    <% end %>

    <main class={if @current_scope && !assigns[:hide_header], do: "pt-20 pb-20 md:pt-0 md:pb-0", else: ""}>
      {@inner_content}
    </main>

    <%!-- Footer (only show on authenticated pages) --%>
    <%= if @current_scope && !assigns[:hide_header] do %>
      <footer class="hidden md:block border-t border-gray-200 py-8 mt-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="flex items-center space-x-2 mb-4 md:mb-0">
              <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-lg flex items-center justify-center shadow-md">
                <span class="text-white text-sm font-bold">H</span>
              </div>
              <span class="text-lg font-semibold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">
                Habit Tracker
              </span>
            </div>
            <div class="text-sm text-gray-600">
              © <%= DateTime.utc_now().year %> Habit Tracker. Built with Phoenix LiveView.
            </div>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
