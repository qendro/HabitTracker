# Elixir Buildpack Configuration
# https://github.com/HashNuke/heroku-buildpack-elixir

# Elixir version
elixir_version=1.19.5

# Erlang version
erlang_version=28.3

# Always rebuild from scratch on every deploy
always_rebuild=false

# Create a release using `mix release`
release=true

# A command to run right before fetching dependencies
hook_pre_fetch_dependencies="scripts/buildpack_pre_fetch.sh"

# A command to run right before compiling the app
hook_pre_compile="mix assets.deploy"

hook_compile="mix do compile, release"

# A command to run right after compiling the app
hook_post_compile="echo 'Build complete!'"
