# Gigalixir Deployment Container
# Self-contained environment for deploying to Gigalixir
FROM elixir:1.15-alpine

# Install all required tools
RUN apk add --no-cache \
    build-base \
    git \
    curl \
    python3 \
    py3-pip \
    openssl \
    bash

# Install Gigalixir CLI
RUN pip3 install gigalixir --break-system-packages

# Set working directory
WORKDIR /app

# Install hex + rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Default command
CMD ["/bin/bash"]
