# Development Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env file with real values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Full database URL (alternative to individual settings below)
DATABASE_URL=ecto://postgres:postgres@localhost/habit_tracker_dev

# Individual database settings (used if DATABASE_URL not set)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_NAME=habit_tracker_dev
DATABASE_PORT=5432

# For Docker: use 'db' as host instead of 'localhost'
# DATABASE_HOST=db

# =============================================================================
# PHOENIX CONFIGURATION
# =============================================================================

# Secret key base (generate with: mix phx.gen.secret)
# This is a development key - generate a new one for production
SECRET_KEY_BASE=your-secret-key-base-here-at-least-64-characters-long-change-this

# Application host
PHX_HOST=localhost

# Start Phoenix server (set to true for development)
PHX_SERVER=true

# Mix environment
MIX_ENV=dev

# Port (default: 4000)
PORT=4000

# =============================================================================
# EMAIL CONFIGURATION (RESEND)
# =============================================================================

# Resend API Key
# Get your API key from https://resend.com/api-keys
# For development, you can use a test key or leave empty to use dev mailbox
RESEND_API_KEY=

# Application URL (used for email links)
APP_URL=http://localhost:4000

# Sender email address
SENDER_EMAIL=noreply@localhost

# =============================================================================
# ERROR TRACKING (SENTRY) - OPTIONAL
# =============================================================================

# Sentry DSN (leave empty for development)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting (default: true)
# Set to false to disable during development if needed
# RATE_LIMITING=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable LiveView debug mode
# LIVE_VIEW_DEBUG=true

# Enable Ecto query logging
# ECTO_LOG_LEVEL=debug

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env: cp .env.dev .env
# 2. Update values as needed for your local setup
# 3. Never commit .env file to version control
# 4. For Docker: change DATABASE_HOST to 'db'
# 5. For email testing, use http://localhost:4000/dev/mailbox
