# Northflank production environment variables

# Required
DATABASE_URL=ecto://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret
PHX_HOST=your-service-or-custom-domain

# Recommended
APP_URL=https://your-service-or-custom-domain
POOL_SIZE=1
PORT=4000

# Optional integrations
RESEND_API_KEY=
SENDER_EMAIL=noreply@your-service-or-custom-domain
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
